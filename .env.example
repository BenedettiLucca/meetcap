# OpenRouter API key for AI summaries + task suggestions
OPENROUTER_API_KEY=

# Whisper transcription settings
MEETCAP_MODEL=large-v3-turbo
MEETCAP_DEVICE=cuda
MEETCAP_COMPUTE=float16

# LLM model for summary + task suggestions
MEETCAP_LLM_MODEL=qwen/qwen3.7-flash

# Optional: Obsidian vault path
OBSIDIAN_VAULT_PATH=

# Retention / Disk budget for raw WAV recordings (#36)
# Purge WAVs older than N days if transcript is complete (default 0 = disabled)
MEETCAP_RETENTION_DAYS=0
# Minimum free disk space in GB required to start recording (default 2.0)
MEETCAP_MIN_FREE_GB=2.0
