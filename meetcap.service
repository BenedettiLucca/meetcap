[Unit]
Description=Meetcap Meeting Recorder Daemon
After=pipewire.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/home/lucca/Projects/meetcap/.venv/lib/python3.11/site-packages/nvidia/cublas/lib:/home/lucca/Projects/meetcap/.venv/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib
Environment=MEETCAP_MODEL=large-v3-turbo
Environment=MEETCAP_DEVICE=cuda
Environment=MEETCAP_COMPUTE=float16
Environment=MEETCAP_LLM_MODEL=qwen/qwen3.7-flash
Environment=OBSIDIAN_VAULT_PATH=/home/lucca/HD2/vault
EnvironmentFile=/home/lucca/.hermes/.env
ExecStart=/home/lucca/Projects/meetcap/.venv/bin/python /home/lucca/Projects/meetcap/src/meetcap.py daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
